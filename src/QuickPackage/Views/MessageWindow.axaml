<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="QuickPackage.Views.MessageWindow"
        Width="560" MaxHeight="720" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13"/>
    <TextBox x:Name="DetailsBox" IsVisible="False" IsReadOnly="True"
             AcceptsReturn="True" TextWrapping="NoWrap" Classes="mono" FontSize="11"
             MaxHeight="360"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
      <Button x:Name="CancelButton" Content="Cancel" MinWidth="88"/>
      <Button x:Name="OkButton" Content="OK" MinWidth="88" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
