<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuickPackage.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="QuickPackage.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="QuickPackage"
        Width="1240" Height="820"
        MinWidth="880" MinHeight="560">

  <Window.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}"/>
    <KeyBinding Gesture="Ctrl+U" Command="{Binding CheckUpdatesCommand}"/>
    <KeyBinding Gesture="Ctrl+I" Command="{Binding InstallSelectedCommand}"/>
    <KeyBinding Gesture="Delete" Command="{Binding RemoveSelectedCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+OemComma" Command="{Binding SettingsCommand}"/>
    <KeyBinding Gesture="Ctrl+Q" Command="{Binding QuitCommand}"/>
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">

    <!-- Menu -->
    <Menu Grid.Row="0" Background="Transparent">
      <MenuItem Header="{Binding L.File}">
        <MenuItem Header="{Binding L.Quit}" InputGesture="Ctrl+Q" Command="{Binding QuitCommand}"/>
      </MenuItem>
      <MenuItem Header="{Binding L.Packages}">
        <MenuItem Header="{Binding L.RefreshLists}" InputGesture="F5" Command="{Binding RefreshCommand}"/>
        <MenuItem Header="{Binding L.CheckForUpdates}" InputGesture="Ctrl+U" Command="{Binding CheckUpdatesCommand}"/>
        <Separator/>
        <MenuItem Header="{Binding L.InstallSelected}" InputGesture="Ctrl+I" Command="{Binding InstallSelectedCommand}"/>
        <MenuItem Header="{Binding L.RemoveSelected}" InputGesture="Delete" Command="{Binding RemoveSelectedCommand}"/>
        <Separator/>
        <MenuItem Header="{Binding UpdatesChipText}" Command="{Binding ShowUpdatesCommand}" IsEnabled="{Binding HasUpdates}"/>
      </MenuItem>
      <MenuItem Header="{Binding L.Settings}">
        <MenuItem Header="{Binding L.Preferences}" InputGesture="Ctrl+Shift+OemComma" Command="{Binding SettingsCommand}"/>
        <MenuItem Header="{Binding L.ConfigureProxy}" Command="{Binding ProxyCommand}"/>
      </MenuItem>
      <MenuItem Header="{Binding L.Help}">
        <MenuItem Header="{Binding L.About}" Command="{Binding AboutCommand}"/>
      </MenuItem>
    </Menu>

    <!-- Toolbar: big system / developer switch, search and actions -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" Margin="12,6,12,4" ColumnSpacing="10">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
        <ToggleButton Classes="mode" Content="{Binding L.SystemPackages}"
                      IsChecked="{Binding IsSystemMode, Mode=TwoWay}"/>
        <ToggleButton Classes="mode" Content="{Binding L.DeveloperPackages}"
                      IsChecked="{Binding IsDevMode, Mode=TwoWay}"
                      IsVisible="{Binding HasDevBackends}"/>
      </StackPanel>

      <TextBox Grid.Column="1" Text="{Binding SearchText, Mode=TwoWay}"
               PlaceholderText="{Binding L.SearchPackages}" VerticalAlignment="Center"/>

      <Button Grid.Column="2" Classes="toolbar" Content="{Binding L.Refresh}"
              Command="{Binding RefreshCommand}" IsEnabled="{Binding IsNotBusy}"/>
      <Button Grid.Column="3" Classes="toolbar" Content="{Binding UpdatesButtonText}"
              Command="{Binding ShowUpdatesCommand}" IsEnabled="{Binding HasUpdates}"/>
    </Grid>

    <!-- Filter chips -->
    <DockPanel Grid.Row="2" Margin="12,2,12,6">
      <ToggleButton DockPanel.Dock="Right" Classes="chip" Margin="8,0,0,0"
                    Content="{Binding UpdatesChipText}"
                    IsChecked="{Binding ShowUpdatesOnly, Mode=TwoWay}"
                    IsEnabled="{Binding HasUpdates}"
                    ToolTip.Tip="{Binding L.ShowOnlyUpdates}"/>
      <ItemsControl ItemsSource="{Binding Chips}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ChipViewModel">
            <ToggleButton Classes="chip" Margin="0,0,6,4"
                          Content="{Binding Label}"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          IsVisible="{Binding IsVisible}"
                          IsEnabled="{Binding IsEnabled}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DockPanel>

    <!-- Master / detail -->
    <Grid Grid.Row="3" ColumnDefinitions="*,340" Margin="12,0,12,8">

      <Border Grid.Column="0" Classes="pane">
        <Grid>
          <ListBox Classes="packages" x:Name="PackageList"
                   ItemsSource="{Binding Packages}"
                   SelectedItem="{Binding SelectedPackage, Mode=TwoWay}"
                   Padding="2">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PackageItemViewModel">
                <Border Classes="card">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="9"
                            Background="{Binding IconBackground}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding IconGlyph}" Foreground="{Binding IconForeground}"
                                 FontWeight="Bold" FontSize="15"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="2" Margin="10,0" Spacing="2" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding VersionText}" Classes="subtle" FontSize="12"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Subtitle}" Classes="subtle" FontSize="12"
                                 TextTrimming="CharacterEllipsis"
                                 IsVisible="{Binding Subtitle, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Border Classes="pill" Background="{Binding BadgeBackground}" IsVisible="{Binding ShowBadge}">
                        <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeForeground}" FontSize="11"/>
                      </Border>
                      <Border Classes="pill" Background="{Binding TagBackground}">
                        <TextBlock Text="{Binding TagText}" Foreground="{Binding TagForeground}"
                                   FontWeight="{Binding TagFontWeight}" FontSize="11"/>
                      </Border>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Text="{Binding L.BackendsDisabledHint}"
                     IsVisible="{Binding ShowBackendHint}"
                     TextWrapping="Wrap" MaxWidth="420"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     TextAlignment="Center" Classes="subtle"/>

          <TextBlock Text="{Binding L.NoMatchingPackages}"
                     IsVisible="{Binding ShowEmpty}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Classes="subtle"/>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="pane" Margin="10,0,0,0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="14">
            <StackPanel IsVisible="{Binding !IsPackageSelected}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="{Binding L.SelectPackageHint}" TextWrapping="Wrap"
                         TextAlignment="Center" Classes="subtle"/>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsPackageSelected}" Spacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding SelectedPackage.Name}" Classes="h1"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Classes="pill" Background="{Binding SelectedPackage.TagBackground}"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding SelectedPackage.TagText}"
                             Foreground="{Binding SelectedPackage.TagForeground}" FontSize="11"/>
                </Border>
              </Grid>

              <ItemsControl ItemsSource="{Binding DetailFields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DetailFieldViewModel">
                    <Grid ColumnDefinitions="96,*" Margin="0,2">
                      <TextBlock Text="{Binding Label}" Classes="subtle" FontSize="12"
                                 VerticalAlignment="Top"/>
                      <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12"
                                 IsVisible="{Binding !IsLink}"/>
                      <HyperlinkButton Grid.Column="1" Content="{Binding Value}" FontSize="12"
                                       Padding="0" Command="{Binding OpenCommand}"
                                       IsVisible="{Binding IsLink}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding DetailDescription}" TextWrapping="Wrap" FontSize="12"
                         IsVisible="{Binding HasDetailDescription}"/>

              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="{Binding L.Install}"
                        Command="{Binding InstallPackageCommand}"
                        CommandParameter="{Binding SelectedPackage}"
                        IsEnabled="{Binding CanInstallSelectedPackage}"/>
                <Button Content="{Binding L.UpdateDetail}"
                        Command="{Binding UpdatePackageCommand}"
                        CommandParameter="{Binding SelectedPackage}"
                        IsEnabled="{Binding CanUpdateSelectedPackage}"/>
                <Button Content="{Binding L.UninstallDetail}"
                        Command="{Binding UninstallPackageCommand}"
                        CommandParameter="{Binding SelectedPackage}"
                        IsEnabled="{Binding CanUninstallSelectedPackage}"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Bottom actions -->
    <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto" Margin="12,0,12,8" ColumnSpacing="8">
      <Button Grid.Column="0" Classes="toolbar" Content="{Binding L.Install}"
              Command="{Binding InstallSelectedCommand}" IsEnabled="{Binding CanInstallRemove}"/>
      <Button Grid.Column="1" Classes="toolbar" Content="{Binding L.Remove}"
              Command="{Binding RemoveSelectedCommand}" IsEnabled="{Binding CanInstallRemove}"/>
      <TextBlock Grid.Column="3" Text="{Binding CountText}" Classes="subtle"
                 VerticalAlignment="Center" FontSize="12"/>
    </Grid>

    <!-- Activity log header (always visible) -->
    <Border Grid.Row="5" Background="{DynamicResource PaneBrush}" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource CardBorderBrush}" Padding="12,3">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <Button Grid.Column="0" Classes="ghost" Padding="4,2"
                Command="{Binding ToggleLogCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding LogChevron}" FontSize="10" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding L.ActivityLog}" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <TextBlock Grid.Column="1" Text="{Binding CurrentCommand}" Classes="mono" FontSize="11"
                   Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding HasCurrentCommand}"/>
        <Button Grid.Column="2" Classes="ghost" Content="{Binding L.CopyLog}" FontSize="11"
                Padding="8,2" Command="{Binding CopyLogCommand}"/>
        <Button Grid.Column="3" Classes="ghost" Content="{Binding L.ClearLog}" FontSize="11"
                Padding="8,2" Command="{Binding ClearLogCommand}"/>
      </Grid>
    </Border>

    <!-- Activity log body: collapsible and resizable with the handle above it -->
    <Grid Grid.Row="6" RowDefinitions="Auto,*" IsVisible="{Binding IsLogExpanded}"
          Height="{Binding LogPanelHeight}" ClipToBounds="True">
      <Thumb Grid.Row="0" Classes="logresize"
             DragDelta="OnLogResizeDrag" DragCompleted="OnLogResizeCompleted"/>
      <Border Grid.Row="1" Classes="pane" Margin="12,0,12,6">
        <ScrollViewer x:Name="LogScroll" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto" Padding="10,6">
          <ItemsControl ItemsSource="{Binding LogEntries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LogEntryViewModel">
                <Grid>
                  <!-- Plain output inherits the theme foreground (a null brush would draw nothing). -->
                  <TextBlock Text="{Binding Text}" Classes="mono" FontSize="11"
                             FontWeight="{Binding FontWeight}" TextWrapping="NoWrap"
                             IsVisible="{Binding IsPlain}"/>
                  <TextBlock Text="{Binding Text}" Classes="mono" FontSize="11"
                             Foreground="{Binding Foreground}"
                             FontWeight="{Binding FontWeight}" TextWrapping="NoWrap"
                             IsVisible="{Binding !IsPlain}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="7" Background="{DynamicResource PaneBrush}" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource CardBorderBrush}" Padding="12,6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusMessage}" Classes="subtle" FontSize="12"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="160" Height="4"
                     IsVisible="{Binding IsBusy}" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
