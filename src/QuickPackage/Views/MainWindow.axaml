<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuickPackage.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="QuickPackage.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="QuickPackage"
        Width="1240" Height="820"
        MinWidth="880" MinHeight="560">

  <Window.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}"/>
    <KeyBinding Gesture="Ctrl+U" Command="{Binding CheckUpdatesCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+OemComma" Command="{Binding SettingsCommand}"/>
    <KeyBinding Gesture="Escape" Command="{Binding StopCommand}"/>
    <KeyBinding Gesture="Ctrl+Q" Command="{Binding QuitCommand}"/>
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

    <!-- Menu -->
    <Menu Grid.Row="0" Background="Transparent">
      <MenuItem Header="{Binding L.File}">
        <MenuItem Header="{Binding L.Quit}" InputGesture="Ctrl+Q" Command="{Binding QuitCommand}"/>
      </MenuItem>
      <MenuItem Header="{Binding L.Packages}">
        <MenuItem Header="{Binding L.RefreshLists}" InputGesture="F5" Command="{Binding RefreshCommand}"/>
        <MenuItem Header="{Binding L.SyncDatabases}" Command="{Binding SyncDatabasesCommand}"/>
        <MenuItem Header="{Binding L.CheckForUpdates}" InputGesture="Ctrl+U" Command="{Binding CheckUpdatesCommand}"/>
        <MenuItem Header="{Binding UpdateAllText}" Command="{Binding UpdateAllCommand}"
                  IsEnabled="{Binding HasAnyUpdates}"/>
        <Separator/>
        <MenuItem Header="{Binding L.Snapshots}" Command="{Binding SnapshotsCommand}"/>
        <MenuItem Header="{Binding L.CacheCleanup}" Command="{Binding CacheCleanupCommand}"/>
        <MenuItem Header="{Binding L.History}" Command="{Binding HistoryCommand}"/>
        <MenuItem Header="{Binding L.InstallLocalPackage}" Click="OnInstallLocalPackage"/>
        <Separator/>
        <MenuItem Header="{Binding UpdatesChipText}" ToggleType="CheckBox"
                  IsChecked="{Binding ShowUpdatesOnly, Mode=TwoWay}"
                  IsEnabled="{Binding HasUpdates}"/>
      </MenuItem>
      <MenuItem Header="{Binding L.Settings}">
        <MenuItem Header="{Binding L.Preferences}" InputGesture="Ctrl+Shift+OemComma" Command="{Binding SettingsCommand}"/>
      </MenuItem>
      <MenuItem Header="{Binding L.Help}">
        <MenuItem Header="{Binding L.News}" Command="{Binding NewsCommand}"/>
        <MenuItem Header="{Binding L.Diagnostics}" Command="{Binding DiagnosticsCommand}"/>
        <MenuItem Header="{Binding L.About}" Command="{Binding AboutCommand}"/>
      </MenuItem>
    </Menu>

    <!-- Top bar: package mode, the long search field and contextual actions. -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="12,6,12,4" ColumnSpacing="10">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
        <ToggleButton Classes="mode" Content="{Binding L.SystemPackages}"
                      IsChecked="{Binding IsSystemMode, Mode=TwoWay}"/>
        <ToggleButton Classes="mode" Content="{Binding L.DeveloperPackages}"
                      IsChecked="{Binding IsDevMode, Mode=TwoWay}"
                      IsVisible="{Binding HasDevBackends}"/>
      </StackPanel>

      <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <TextBox x:Name="SearchBox" Text="{Binding SearchText, Mode=TwoWay}"
                 KeyDown="OnSearchKeyDown"
                 PlaceholderText="{Binding L.SearchPackages}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
          <Button Classes="ghost" Content="✕" Padding="7,2" FontSize="12"
                  Command="{Binding ClearSearchCommand}"
                  IsVisible="{Binding HasSearchText}"
                  ToolTip.Tip="{Binding L.ClearSearch}"/>
          <Button Classes="ghost" Content="🕘" Padding="7,2" FontSize="12"
                  Click="OnSearchHistory"
                  IsVisible="{Binding HasSearchHistory}"
                  ToolTip.Tip="{Binding L.SearchHistory}"/>
          <Button Classes="toolbar" Content="{Binding L.SearchOnline}"
                  IsVisible="{Binding CanSearchOnline}"
                  IsEnabled="{Binding CanSearchOnline}"
                  ToolTip.Tip="{Binding L.SearchOnlineHint}">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="{Binding L.SearchAur}"
                          Command="{Binding SearchAurCommand}"
                          IsEnabled="{Binding CanSearchAur}"/>
                <MenuItem Header="{Binding L.SearchFlatpak}"
                          Command="{Binding SearchFlatpakCommand}"
                          IsEnabled="{Binding CanSearchFlatpak}"/>
                <MenuItem Header="{Binding L.SearchCrates}"
                          Command="{Binding SearchCratesCommand}"
                          IsEnabled="{Binding CanSearchCrates}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Actions live beside the search field so they never consume list height. -->
      <WrapPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                 VerticalAlignment="Center">
        <Button Classes="ghost" Content="↻" FontSize="15" Padding="7,1" Margin="0,0,4,0"
                Command="{Binding RefreshCommand}" IsEnabled="{Binding IsNotBusy}"
                IsVisible="{Binding !ShowActionBar}"
                ToolTip.Tip="{Binding L.RefreshLists}"/>
        <Button Classes="ghost" Content="⚠" FontSize="13" Padding="7,1" Margin="0,0,4,0"
                Command="{Binding DiagnosticsCommand}"
                IsVisible="{Binding HasBackendIssues}"
                ToolTip.Tip="{Binding BackendIssueText}"/>
        <Button Classes="groupfilter" Content="{Binding L.ClearFilters}"
                Command="{Binding ClearFiltersCommand}" Margin="0,0,6,0"
                IsVisible="{Binding HasActiveFilters}"
                ToolTip.Tip="{Binding L.ClearFiltersHint}"/>
        <ToggleButton Classes="chip" Content="{Binding SelectModeText}"
                      IsChecked="{Binding IsSelectionMode, Mode=TwoWay}"
                      ToolTip.Tip="{Binding L.SelectPackagesHint}"/>
        <TextBlock Text="{Binding ActionBarText}" Classes="subtle" FontSize="12"
                   VerticalAlignment="Center" Margin="10,0,8,0"
                   IsVisible="{Binding ShowActionBar}"/>
        <Button Classes="ghost" Content="{Binding L.SelectAll}"
                Command="{Binding SelectAllVisibleCommand}"
                IsVisible="{Binding ShowActionBar}"
                FontSize="11" Padding="8,2" Margin="0,0,4,0"/>
        <Button Classes="ghost" Content="{Binding L.ClearSelection}"
                Command="{Binding ClearSelectedCommand}"
                IsVisible="{Binding ShowActionBar}"
                FontSize="11" Padding="8,2" Margin="0,0,8,0"/>
        <Button Classes="toolbar" Content="{Binding UpdateSelectedText}"
                Command="{Binding UpdateSelectedCommand}"
                IsVisible="{Binding ShowUpdateAction}"
                IsEnabled="{Binding CanBulkUpdate}" Margin="0,0,4,0"/>
        <Button Classes="toolbar" Content="{Binding RemoveSelectedText}"
                Command="{Binding RemoveSelectedOrphansCommand}"
                IsVisible="{Binding ShowOrphanAction}"
                IsEnabled="{Binding CanBulkUpdate}" Margin="0,0,4,0"/>
        <Button Classes="toolbar" Content="{Binding InstallSelectedText}"
                Command="{Binding InstallSelectedCommand}"
                IsVisible="{Binding ShowBulkInstall}"
                IsEnabled="{Binding CanBulkInstall}" Margin="0,0,4,0"/>
        <Button Classes="toolbar danger" Content="{Binding UninstallSelectedText}"
                Command="{Binding UninstallSelectedCommand}"
                IsVisible="{Binding ShowBulkUninstall}"
                IsEnabled="{Binding CanBulkUninstall}"/>
      </WrapPanel>
    </Grid>

    <!-- Filter chips -->
    <DockPanel Grid.Row="2" Margin="12,2,12,6">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                  Margin="0,0,4,0" VerticalAlignment="Center">
        <ToggleButton Classes="chip" Content="{Binding L.InstalledOnly}"
                      Margin="0,0,6,4"
                      IsChecked="{Binding IsInstalledFilter, Mode=TwoWay}"/>
        <ToggleButton Classes="chip" Content="{Binding L.NotInstalledOnly}"
                      Margin="0,0,6,4"
                      IsChecked="{Binding IsNotInstalledFilter, Mode=TwoWay}"/>
        <ToggleButton Classes="chip" Content="{Binding L.AllPackages}"
                      Margin="0,0,0,4"
                      IsChecked="{Binding IsAllPackagesFilter, Mode=TwoWay}"/>
      </StackPanel>
      <Border DockPanel.Dock="Left" Width="1" Height="20"
              VerticalAlignment="Center"
              Background="{DynamicResource CardBorderBrush}"
              Margin="0,0,10,4"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                  VerticalAlignment="Center">
        <ComboBox ItemsSource="{Binding SortOptions}"
                  SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                  MinWidth="112" FontSize="12" VerticalAlignment="Center"
                  ToolTip.Tip="{Binding L.SortByHint}"/>
        <Button Classes="ghost" Content="{Binding SortDirectionText}" FontSize="13"
                Padding="7,1" Command="{Binding ToggleSortDirectionCommand}"
                ToolTip.Tip="{Binding L.SortDirectionHint}"/>
        <ComboBox ItemsSource="{Binding OriginOptions}"
                  SelectedItem="{Binding SelectedOrigin, Mode=TwoWay}"
                  MinWidth="128" FontSize="12" VerticalAlignment="Center"
                  ToolTip.Tip="{Binding L.OriginFilterHint}"/>
        <Button Classes="groupfilter"
                Content="{Binding GroupFilterText}"
                Command="{Binding ClearGroupFilterCommand}"
                IsVisible="{Binding HasGroupFilter}"
                ToolTip.Tip="{Binding L.ClearGroupFilter}"/>
        <ToggleButton Classes="chip"
                      Content="{Binding OrphansChipText}"
                      IsChecked="{Binding ShowOrphansOnly, Mode=TwoWay}"
                      IsEnabled="{Binding HasOrphans}"
                      ToolTip.Tip="{Binding L.ShowOnlyOrphans}"/>
        <ToggleButton Classes="chip"
                      Content="{Binding UpdatesChipText}"
                      IsChecked="{Binding ShowUpdatesOnly, Mode=TwoWay}"
                      IsEnabled="{Binding HasUpdates}"
                      ToolTip.Tip="{Binding L.ShowOnlyUpdates}"/>
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Chips}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ChipViewModel">
            <ToggleButton Classes="chip" Margin="0,0,6,4"
                          Content="{Binding Label}"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          IsVisible="{Binding IsVisible}"
                          IsEnabled="{Binding IsEnabled}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DockPanel>

    <!-- Master / detail: 3:2 by default, resizable and remembered. -->
    <Grid Grid.Row="3" x:Name="ContentSplit" Margin="12,0,12,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="360"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="2*" MinWidth="300"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Classes="pane">
        <Grid>
          <ListBox Classes="packages" x:Name="PackageList"
                   ItemsSource="{Binding Packages}"
                   SelectedItem="{Binding SelectedPackage, Mode=TwoWay}"
                   Padding="2">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PackageItemViewModel">
                <Border Classes="card" PointerPressed="OnPackagePointerPressed">
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{Binding InstallText}" Command="{Binding InstallCommand}"
                                CommandParameter="{Binding}" IsVisible="{Binding ShowInstallAction}"/>
                      <MenuItem Header="{Binding UpdateText}" Command="{Binding UpdateCommand}"
                                CommandParameter="{Binding}" IsVisible="{Binding ShowInstalledActions}"/>
                      <MenuItem Header="{Binding UninstallText}" Command="{Binding UninstallCommand}"
                                CommandParameter="{Binding}" IsVisible="{Binding ShowInstalledActions}"/>
                      <Separator/>
                      <MenuItem Header="{Binding FilesText}" Command="{Binding FilesCommand}"
                                CommandParameter="{Binding}" IsVisible="{Binding ShowFilesAction}"/>
                      <MenuItem Header="{Binding MakeExplicitText}" Command="{Binding MakeExplicitCommand}"
                                CommandParameter="{Binding}" IsVisible="{Binding ShowMakeExplicitAction}"/>
                      <MenuItem Header="{Binding IgnoreText}" Command="{Binding ToggleIgnoreCommand}"
                                CommandParameter="{Binding}" IsVisible="{Binding ShowInstalledActions}"/>
                      <MenuItem Header="{Binding DownloadText}" Command="{Binding DownloadCommand}"
                                CommandParameter="{Binding}" IsVisible="{Binding ShowDownloadAction}"/>
                      <MenuItem Header="{Binding ReinstallText}" Command="{Binding ReinstallCommand}"
                                CommandParameter="{Binding}" IsVisible="{Binding ShowReinstallAction}"/>
                      <MenuItem Header="{Binding DowngradeText}" Command="{Binding DowngradeCommand}"
                                CommandParameter="{Binding}" IsVisible="{Binding ShowDowngradeAction}"/>
                      <Separator/>
                      <MenuItem Header="{Binding CopyNameText}" Command="{Binding CopyNameCommand}"
                                CommandParameter="{Binding}"/>
                      <MenuItem Header="{Binding OpenAurText}" Command="{Binding OpenAurCommand}"
                                CommandParameter="{Binding}" IsVisible="{Binding ShowAurAction}"/>
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              IsVisible="{Binding ShowSelection}"
                              VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0" Spacing="2" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding VersionText}" Classes="subtle" FontSize="13"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center">
                          <Border Classes="pill tag" IsVisible="{Binding HasOrigin}"
                                  VerticalAlignment="Center"
                                  Background="{Binding OriginBackground}"
                                  BorderBrush="{Binding OriginBorderBrush}">
                            <TextBlock Text="{Binding OriginText}" FontSize="11"
                                       Foreground="{Binding OriginForeground}"/>
                          </Border>
                          <Border Classes="pill tag" IsVisible="{Binding ShowInstallReason}"
                                  VerticalAlignment="Center"
                                  Background="{Binding ReasonBackground}"
                                  BorderBrush="{Binding ReasonBorderBrush}">
                            <TextBlock Text="{Binding InstallReasonText}" FontSize="11"
                                       Foreground="{Binding ReasonForeground}"/>
                          </Border>
                          <Border Classes="pill tag" IsVisible="{Binding ShowOrphan}"
                                  VerticalAlignment="Center"
                                  Background="{DynamicResource DangerBackgroundBrush}"
                                  BorderBrush="{DynamicResource DangerBorderBrush}">
                            <TextBlock Text="{Binding OrphanText}" FontSize="11"
                                       Foreground="{DynamicResource DangerBrush}"/>
                          </Border>
                          <ItemsControl ItemsSource="{Binding GroupChips}"
                                        IsVisible="{Binding HasGroups}"
                                        VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:DependencyViewModel">
                                <Button Classes="groupchip" Content="{Binding Name}"
                                      Command="{Binding NavigateCommand}"
                                      CommandParameter="{Binding Name}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Subtitle}" Classes="subtle" FontSize="13"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   IsVisible="{Binding Subtitle, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                      </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Border Classes="pill" Background="{Binding BadgeBackground}" IsVisible="{Binding ShowBadge}">
                        <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeForeground}" FontSize="12"/>
                      </Border>
                      <Border Classes="pill" Background="{Binding TagBackground}">
                        <TextBlock Text="{Binding TagText}" Foreground="{Binding TagForeground}"
                                   FontWeight="{Binding TagFontWeight}" FontSize="12"/>
                      </Border>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Text="{Binding L.BackendsDisabledHint}"
                     IsVisible="{Binding ShowBackendHint}"
                     TextWrapping="Wrap" MaxWidth="420"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     TextAlignment="Center" Classes="subtle"/>

          <TextBlock Text="{Binding L.NoMatchingPackages}"
                     IsVisible="{Binding ShowEmpty}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Classes="subtle"/>
        </Grid>
      </Border>

      <Panel Grid.Column="1">
        <Border Width="1" HorizontalAlignment="Center" IsHitTestVisible="False"
                Background="{DynamicResource CardBorderBrush}"/>
        <GridSplitter ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      Background="Transparent" Cursor="SizeWestEast"
                      DragCompleted="OnContentSplitDragCompleted"/>
      </Panel>

      <Border Grid.Column="2" Classes="pane" Margin="4,0,0,0">
        <Grid>
          <StackPanel IsVisible="{Binding !IsPackageSelected}"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding L.SelectPackageHint}" TextWrapping="Wrap"
                       TextAlignment="Center" Classes="subtle"/>
          </StackPanel>

          <Grid IsVisible="{Binding IsPackageSelected}" RowDefinitions="Auto,*"
                Margin="14" RowSpacing="10">
            <!-- Navigation and actions stay pinned above the scrollable details. -->
            <StackPanel Grid.Row="0" Spacing="10">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                <Button Classes="toolbar" Command="{Binding GoBackCommand}"
                        ToolTip.Tip="{Binding L.Back}" Padding="0" Width="30" Height="28"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        VerticalAlignment="Center">
                  <TextBlock Text="←" FontSize="16" HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Button>
                <Button Grid.Column="1" Classes="toolbar" Command="{Binding GoForwardCommand}"
                        ToolTip.Tip="{Binding L.Forward}" Padding="0" Width="30" Height="28"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        VerticalAlignment="Center">
                  <TextBlock Text="→" FontSize="16" HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Button>
                <TextBlock Grid.Column="2" Text="{Binding SelectedPackage.Name}" Classes="h1"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,0,0,0"/>
                <Border Grid.Column="3" Classes="pill" Background="{Binding SelectedPackage.TagBackground}"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding SelectedPackage.TagText}"
                             Foreground="{Binding SelectedPackage.TagForeground}" FontSize="11"/>
                </Border>
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="detail" Content="{Binding L.Install}"
                        Command="{Binding InstallPackageCommand}"
                        CommandParameter="{Binding SelectedPackage}"
                        IsVisible="{Binding CanInstallSelectedPackage}"
                        IsEnabled="{Binding CanInstallSelectedPackage}"/>
                <Button Classes="detail primary" Content="{Binding L.UpdateDetail}"
                        Command="{Binding UpdatePackageCommand}"
                        CommandParameter="{Binding SelectedPackage}"
                        IsVisible="{Binding IsInstalledSelectedPackage}"
                        IsEnabled="{Binding CanUpdateSelectedPackage}"/>
                <Button Classes="detail danger" Content="{Binding L.UninstallDetail}"
                        Command="{Binding UninstallPackageCommand}"
                        CommandParameter="{Binding SelectedPackage}"
                        IsVisible="{Binding CanUninstallSelectedPackage}"
                        IsEnabled="{Binding CanUninstallSelectedPackage}"/>
                <!-- Promotion to explicit is rare, so it lives in a small menu. -->
                <Button Classes="detail" Content="{Binding L.More}"
                        IsVisible="{Binding CanMoreActions}">
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuItem Header="{Binding L.Files}"
                                Command="{Binding ShowPackageFilesCommand}"
                                CommandParameter="{Binding SelectedPackage}"/>
                      <MenuItem Header="{Binding IgnoreMenuText}"
                                Command="{Binding ToggleIgnoreCommand}"
                                CommandParameter="{Binding SelectedPackage}"/>
                      <MenuItem Header="{Binding L.DownloadOnly}"
                                Command="{Binding DownloadPackageCommand}"
                                CommandParameter="{Binding SelectedPackage}"
                                IsVisible="{Binding CanDownload}"/>
                      <MenuItem Header="{Binding L.Reinstall}"
                                Command="{Binding ReinstallPackageCommand}"
                                CommandParameter="{Binding SelectedPackage}"
                                IsVisible="{Binding CanReinstall}"/>
                      <MenuItem Header="{Binding L.Downgrade}"
                                Command="{Binding DowngradePackageCommand}"
                                CommandParameter="{Binding SelectedPackage}"
                                IsVisible="{Binding CanDowngrade}"/>
                      <MenuItem Header="{Binding L.DependencyTree}"
                                Command="{Binding ShowDependencyTreeCommand}"
                                CommandParameter="{Binding SelectedPackage}"
                                IsVisible="{Binding CanShowDependencyTree}"/>
                      <MenuItem Header="{Binding L.MakeExplicit}"
                                Command="{Binding MakeExplicitCommand}"
                                CommandParameter="{Binding SelectedPackage}"/>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
            </StackPanel>

            <ScrollViewer x:Name="DetailScroll" Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10">
                <ItemsControl ItemsSource="{Binding DetailFields}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DetailFieldViewModel">
                      <Grid ColumnDefinitions="96,*" Margin="0,2">
                        <TextBlock Text="{Binding Label}" Classes="subtle" FontSize="12"
                                   VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12"
                                   IsVisible="{Binding !IsLink}"/>
                        <HyperlinkButton Grid.Column="1" Content="{Binding Value}" FontSize="12"
                                         Padding="0" Command="{Binding OpenCommand}"
                                         IsVisible="{Binding IsLink}"/>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Chips}"
                                      IsVisible="{Binding IsChips}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DependencyViewModel">
                              <Button Classes="dependency" Content="{Binding Name}"
                                      Command="{Binding NavigateCommand}"
                                      CommandParameter="{Binding Name}"
                                      IsEnabled="{Binding IsAvailable}"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding DetailDescription}" TextWrapping="Wrap" FontSize="12"
                           IsVisible="{Binding HasDetailDescription}"/>

                <StackPanel Spacing="4" IsVisible="{Binding HasForwardDependencies}">
                  <TextBlock Text="{Binding L.DependsOnDeps}" Classes="subtle" FontSize="12"/>
                  <ItemsControl ItemsSource="{Binding ForwardDependencies}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DependencyViewModel">
                        <Button Classes="dependency" Content="{Binding Name}"
                                Command="{Binding NavigateCommand}"
                                IsEnabled="{Binding IsAvailable}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding HasReverseDependencies}">
                  <TextBlock Text="{Binding L.RequiredByDeps}" Classes="subtle" FontSize="12"/>
                  <ItemsControl ItemsSource="{Binding ReverseDependencies}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DependencyViewModel">
                        <Button Classes="dependency" Content="{Binding Name}"
                                Command="{Binding NavigateCommand}"
                                IsEnabled="{Binding IsAvailable}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- Activity log body: collapsible and resizable with the handle above it -->
    <Grid Grid.Row="4" RowDefinitions="Auto,*" IsVisible="{Binding IsLogExpanded}"
          Height="{Binding LogPanelHeight}" ClipToBounds="True">
      <Thumb Grid.Row="0" Classes="logresize"
             DragDelta="OnLogResizeDrag" DragCompleted="OnLogResizeCompleted"/>
      <Border Grid.Row="1" Classes="pane" Margin="12,0,12,4" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <!-- Sticky header: the command that owns the log content at the top. -->
          <Border Grid.Row="0" IsVisible="{Binding ShowLogContext}"
                  Background="{DynamicResource CardBackgroundBrush}"
                  BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardBorderBrush}"
                  CornerRadius="8,8,0,0" Padding="10,3">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBlock Text="{Binding LogContext.Header}" Classes="mono" FontSize="11"
                         Foreground="{Binding LogContext.HeaderBrush}" FontWeight="SemiBold"
                         TextWrapping="Wrap"/>
              <TextBlock Grid.Column="1" Text="{Binding LogContext.StatusText}" FontSize="11"
                         Foreground="{Binding LogContext.StatusBrush}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1" x:Name="LogScroll" HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto" Padding="10,6"
                        ScrollChanged="OnLogScrollChanged">
            <ItemsControl x:Name="LogList" ItemsSource="{Binding LogItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LogItemViewModel">
                <StackPanel Margin="0,0,0,10" Spacing="2">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Text="{Binding Header}" Classes="mono" FontSize="11"
                               Foreground="{Binding HeaderBrush}" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11"
                               Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock Text="{Binding OutputText}" Classes="mono" FontSize="11"
                             IsVisible="{Binding OutputVisible}" TextWrapping="NoWrap"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Slim bottom bar: status/current command plus activity-log controls -->
    <Border Grid.Row="5" Background="{DynamicResource PaneBrush}" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource CardBorderBrush}" Padding="12,3">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Text="{Binding FooterText}" Classes="subtle" FontSize="12"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center" IsVisible="{Binding IsBusy}">
          <ProgressBar IsIndeterminate="{Binding !HasProgress}"
                       Value="{Binding ProgressPercent}" Maximum="100"
                       Width="80" Height="4" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding ProgressText}" Classes="subtle" FontSize="11"
                     VerticalAlignment="Center" IsVisible="{Binding HasProgress}"/>
          <Button Classes="ghost" Content="{Binding L.Stop}" FontSize="11"
                  Padding="8,1" Foreground="#E5534B" Command="{Binding StopCommand}"
                  ToolTip.Tip="{Binding L.Stop}"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                    VerticalAlignment="Center" IsVisible="{Binding IsLogExpanded}">
          <Button Classes="ghost" Content="{Binding L.CopyLog}" FontSize="11"
                  Padding="8,1" Command="{Binding CopyLogCommand}"/>
          <Button Classes="ghost" Content="{Binding L.ClearLog}" FontSize="11"
                  Padding="8,1" Command="{Binding ClearLogCommand}"/>
          <CheckBox Classes="compact" Content="{Binding L.LogDetails}"
                    IsChecked="{Binding IsLogDetailed, Mode=OneWay}"
                    Click="OnLogDetailsClick" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="4" Classes="ghost" Padding="6,1"
                Command="{Binding ToggleLogCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding LogChevron}" FontSize="10" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding L.ActivityLog}" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
