<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuickPackage.ViewModels"
        x:Class="QuickPackage.Views.UpdateWindow"
        x:DataType="vm:UpdateViewModel"
        Width="560" Height="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="12">

    <Grid ColumnDefinitions="Auto,*,110,110,100" ColumnSpacing="8">
      <TextBlock Text="{Binding HeaderPackage}" FontWeight="SemiBold"/>
      <TextBlock Grid.Column="1" Text="{Binding HeaderBackend}" FontWeight="SemiBold"/>
      <TextBlock Grid.Column="2" Text="{Binding HeaderCurrent}" FontWeight="SemiBold"/>
      <TextBlock Grid.Column="3" Text="{Binding HeaderNew}" FontWeight="SemiBold"/>
    </Grid>

    <Border Grid.Row="1" Classes="pane">
      <ListBox ItemsSource="{Binding Items}" Classes="packages" BorderThickness="0"
               Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:UpdateItemViewModel">
            <Grid ColumnDefinitions="Auto,*,110,110,100" ColumnSpacing="8" Margin="0,2">
              <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="2" Text="{Binding BackendLabel}" Classes="subtle"
                         VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="{Binding CurrentVersion}" Classes="subtle"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="4" Text="{Binding NewVersion}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{Binding CancelText}" MinWidth="88" Click="OnCancel"/>
      <Button Content="{Binding UpdateText}" MinWidth="88" IsDefault="True" Click="OnUpdate"/>
    </StackPanel>
  </Grid>
</Window>
