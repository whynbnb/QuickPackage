<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="QuickPackage.Views.PasswordWindow"
        Width="460" Height="280"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="20" RowSpacing="10">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13"/>
    <TextBox x:Name="PasswordInput" Grid.Row="1" PasswordChar="●"
             VerticalContentAlignment="Center"
             KeyDown="OnPasswordKeyDown"/>
    <CheckBox x:Name="RevealCheck" Grid.Row="2" FontSize="12"/>
    <TextBlock x:Name="ErrorText" Grid.Row="3" IsVisible="False"
               TextWrapping="Wrap" FontSize="12" Foreground="#D9534F"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" VerticalAlignment="Bottom">
      <Button x:Name="CancelButton" MinWidth="88" Click="OnCancel"/>
      <Button x:Name="OkButton" MinWidth="88" IsDefault="True" Click="OnOk"/>
    </StackPanel>
  </Grid>
</Window>
