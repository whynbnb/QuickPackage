<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QuickPackage.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <!-- The Fluent theme points this at a bundled Latin-only font with a
           platform-default fallback. Override it with the resolved UI family
           (FontStrategy replaces this value at startup). -->
      <FontFamily x:Key="ContentControlThemeFontFamily">sans-serif</FontFamily>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F5F7"/>
          <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="CardBorderBrush" Color="#E1E4E9"/>
          <SolidColorBrush x:Key="CardHoverBrush" Color="#F1F4F8"/>
          <SolidColorBrush x:Key="PaneBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="SubtleTextBrush" Color="#6B7280"/>
          <SolidColorBrush x:Key="AccentBrush" Color="#2D7FF9"/>
          <SolidColorBrush x:Key="ChipCheckedBrush" Color="#2D7FF9"/>
          <SolidColorBrush x:Key="ChipCheckedTextBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="DangerBrush" Color="#C63B3B"/>
          <SolidColorBrush x:Key="DangerBorderBrush" Color="#E0A5A5"/>
          <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#FDF3F3"/>
          <SolidColorBrush x:Key="DangerHoverBrush" Color="#FBE3E3"/>
          <SolidColorBrush x:Key="PrimaryBorderBrush" Color="#B9D3FB"/>
          <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#EAF2FE"/>
          <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#DCE9FD"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1B1C1F"/>
          <SolidColorBrush x:Key="CardBackgroundBrush" Color="#25272B"/>
          <SolidColorBrush x:Key="CardBorderBrush" Color="#383B41"/>
          <SolidColorBrush x:Key="CardHoverBrush" Color="#2E3136"/>
          <SolidColorBrush x:Key="PaneBrush" Color="#222428"/>
          <SolidColorBrush x:Key="SubtleTextBrush" Color="#9AA0A8"/>
          <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF"/>
          <SolidColorBrush x:Key="ChipCheckedBrush" Color="#3D7DDE"/>
          <SolidColorBrush x:Key="ChipCheckedTextBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B"/>
          <SolidColorBrush x:Key="DangerBorderBrush" Color="#8E4040"/>
          <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#3A2325"/>
          <SolidColorBrush x:Key="DangerHoverBrush" Color="#4A2A2C"/>
          <SolidColorBrush x:Key="PrimaryBorderBrush" Color="#3C5A85"/>
          <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#243247"/>
          <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#2C3D57"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://QuickPackage/Styles/AppStyles.axaml"/>
  </Application.Styles>
</Application>
