<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuickPackage.ViewModels">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
  </Style>

  <Style Selector="TextBlock.subtle">
    <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="ToggleButton.mode">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
  </Style>
  <Style Selector="ToggleButton.mode:checked">
    <Setter Property="Background" Value="{DynamicResource ChipCheckedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ChipCheckedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource ChipCheckedTextBrush}"/>
  </Style>
  <Style Selector="ToggleButton.mode:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ChipCheckedBrush}"/>
  </Style>

  <Style Selector="ToggleButton.chip">
    <Setter Property="CornerRadius" Value="13"/>
    <Setter Property="Padding" Value="12,4"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
  </Style>
  <Style Selector="ToggleButton.chip:checked">
    <Setter Property="Background" Value="{DynamicResource ChipCheckedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ChipCheckedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource ChipCheckedTextBrush}"/>
  </Style>
  <Style Selector="ToggleButton.chip:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ChipCheckedBrush}"/>
  </Style>

  <Style Selector="Border.card">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
    <Setter Property="Padding" Value="12,8"/>
  </Style>

  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="8,1"/>
  </Style>

  <!-- Clickable dependency chips in the detail pane. -->
  <Style Selector="Button.dependency">
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="8,1"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Margin" Value="0,0,4,4"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
  </Style>
  <Style Selector="Button.dependency:disabled">
    <Setter Property="Opacity" Value="0.55"/>
  </Style>

  <!-- Clickable package-group chip; also used on list rows. -->
  <Style Selector="Button.groupchip">
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="8,1"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Margin" Value="0,1,6,1"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource GroupBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource GroupBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource GroupBrush}"/>
  </Style>
  <Style Selector="Button.groupchip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GroupBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource GroupBorderBrush}"/>
  </Style>

  <!-- Active group filter; clicking it clears the filter. -->
  <Style Selector="Button.groupfilter">
    <Setter Property="CornerRadius" Value="13"/>
    <Setter Property="Padding" Value="12,4"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource GroupBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource GroupBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource GroupBrush}"/>
  </Style>

  <!-- Repository / origin tag, outlined so it reads as metadata. -->
  <Style Selector="Border.pill.tag">
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Padding" Value="7,0"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
  </Style>

  <Style Selector="Border.pane">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PaneBrush}"/>
  </Style>

  <Style Selector="ListBox.packages">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="ListBox.packages ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="6,3"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="ListBox.packages ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.packages ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.packages ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.packages ListBoxItem:pointerover Border.card">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
  </Style>
  <Style Selector="ListBox.packages ListBoxItem:selected Border.card">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
  </Style>

  <Style Selector="Button.toolbar">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="12,6"/>
  </Style>
  <Style Selector="Menu">
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}"/>
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}"/>
  </Style>

  <!-- Detail-pane actions share the same geometry; only the semantic tint
       differs (blue for update, red for the destructive uninstall). -->
  <Style Selector="Button.detail">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="12,5"/>
    <Setter Property="MinWidth" Value="64"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
  </Style>
  <Style Selector="Button.detail:disabled">
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
  </Style>

  <!-- Flat, chrome-less buttons used by the activity log header. -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
  </Style>

  <Style Selector="ComboBoxItem" x:DataType="vm:OptionItem">
    <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
  </Style>

  <!-- Tiny checkbox used for the activity log's detail switch, sized to the
       status-bar text so it never increases the footer height. -->
  <Style Selector="CheckBox.compact">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <Border Name="box" Width="13" Height="13" CornerRadius="3"
                  BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                  Background="Transparent" VerticalAlignment="Center">
            <Path Name="check" Data="M 1,4 L 3.5,6.5 L 8,1"
                  Stroke="{DynamicResource ChipCheckedTextBrush}" StrokeThickness="1.6"
                  Width="9" Height="7" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="False"/>
          </Border>
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="CheckBox.compact:checked /template/ Border#box">
    <Setter Property="Background" Value="{DynamicResource ChipCheckedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ChipCheckedBrush}"/>
  </Style>
  <Style Selector="CheckBox.compact:checked /template/ Path#check">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <Style Selector="CheckBox.compact:pointerover /template/ Border#box">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!-- Drag handle on the activity log's top edge. -->
  <Style Selector="Thumb.logresize">
    <Setter Property="Height" Value="7"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Cursor" Value="SizeNorthSouth"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Border Width="42" Height="3" CornerRadius="1.5"
                  Background="{DynamicResource CardBorderBrush}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="DejaVu Sans Mono, Noto Sans Mono CJK SC, monospace"/>
  </Style>
</Styles>
